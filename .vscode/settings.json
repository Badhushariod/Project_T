{
    // Adds an "MSYS2 UCRT64" terminal for this project only.
    // Your other VS Code projects keep their normal default terminal.
    "terminal.integrated.profiles.windows": {
        "MSYS2 UCRT64": {
            "path": "C:\\msys64\\usr\\bin\\bash.exe",
            "args": ["--login", "-i"],
            "env": {
                "MSYSTEM": "UCRT64",
                "CHERE_INVOKING": "1",
                "MSYS2_PATH_TYPE": "inherit"
            }
        }
    },
    "terminal.integrated.defaultProfile.windows": "MSYS2 UCRT64",

    // No automatic code suggestions in this project: write it yourself.
    // Press Ctrl+Space if you ever want the suggestion list on purpose.
    "editor.quickSuggestions": { "other": "off", "comments": "off", "strings": "off" },
    "editor.suggestOnTriggerCharacters": false,
    "editor.wordBasedSuggestions": "off",
    "editor.inlineSuggest.enabled": false,
    "C_Cpp.autocomplete": "disabled",
    "github.copilot.enable": { "*": false }
}
